# ==============================================================================
# SMART WMS ENTERPRISE ENVIRONMENT CONFIGURATION TEMPLATE
# Copy file nay thanh .env de cau hinh bien moi truong cho he thong
# ==============================================================================

# 1. Co so du lieu PostgreSQL
DB_HOST=wms-postgres
DB_PORT=5432
DB_NAME=wms_db
DB_USER=postgres
DB_PASSWORD=password123

# 2. Hang doi RabbitMQ
RABBITMQ_HOST=wms-rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# 3. Luu tru doi tuong MinIO S3
MINIO_ENDPOINT=http://wms-minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=wms-reports

# 4. Dich vu Gui Email SMTP (Gmail App Password)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password_here

# 5. Bao mat JWT (Khoa bi mat HS256 toi thieu 256 bits)
JWT_SECRET_KEY=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# 6. Tro ly AI LLM
LLM_API_KEY=mock-key
